[Unit]
Description=Uterine Ultrasound AI-Assisted Diagnosis System
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/ultrasound/backend
ExecStart=/opt/ultrasound/backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=LOG_FORMAT=json
Environment=COOKIE_SECURE=false

[Install]
WantedBy=multi-user.target
